<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sigap_light">

    <!-- TOOLBAR -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:layout_marginTop="24dp"
        android:background="@color/sigap_blue"
        app:title="Profil Developer"
        app:titleTextColor="@color/sigap_white"
        app:subtitleTextColor="@color/sigap_white"
        app:layout_scrollFlags="scroll|enterAlways"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- HEADER PROFIL -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/sigap_white"
                app:cardCornerRadius="22dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="24dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgDeveloper"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="Foto profil Nailah"
                        android:scaleType="centerCrop"
                        android:src="@drawable/nailah"
                        app:shapeAppearanceOverlay="@style/CircleImageShape" />


                    <TextView
                        android:id="@+id/tvDeveloperName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Nailah Idfi"
                        android:textColor="@color/sigap_blue_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDeveloperRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Mahasiswa Teknik Informatika"
                        android:textColor="@color/sigap_gray"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvDeveloperCampus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Politeknik Caltex Riau"
                        android:textColor="@color/sigap_gray"
                        android:textSize="13sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- TENTANG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Tentang Saya"
                android:textColor="@color/sigap_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/sigap_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="18dp"
                    android:text="Saya merupakan mahasiswa Teknik Informatika yang tertarik pada pengembangan aplikasi, teknologi mobile, dan desain antarmuka. Aplikasi SIGAP dikembangkan sebagai sistem layanan sarana dan prasarana kampus yang mudah digunakan dan terintegrasi."
                    android:textColor="@color/sigap_gray"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

            </androidx.cardview.widget.CardView>

            <!-- DATA DIRI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Informasi Developer"
                android:textColor="@color/sigap_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/sigap_white"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="NIM"
                        android:textColor="@color/sigap_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="2455301137"
                        android:textColor="@color/sigap_blue_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Program Studi"
                        android:textColor="@color/sigap_gray"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Teknik Informatika"
                        android:textColor="@color/sigap_blue_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- KEAHLIAN -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Keahlian"
                android:textColor="@color/sigap_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Android Development&#10;• UI/UX Design&#10;• Kotlin &amp; XML&#10;• Web Development&#10;• Database"
                android:textColor="@color/sigap_gray"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

            <!-- HOBI -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Hobi"
                android:textColor="@color/sigap_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="• Mendengarkan musik&#10;• Desain &amp; Nonton Film&#10;• Badminton"
                android:textColor="@color/sigap_gray"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp" />

            <!-- SOSIAL MEDIA -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Social Media"
                android:textColor="@color/sigap_blue_dark"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInstagram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Instagram  •  @nelaasinaga"
                android:textColor="@color/sigap_gray"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="GitHub  •  github.com/Nailah24-TI"
                android:textColor="@color/sigap_gray"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="30dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>