<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sigap_light">

    <!-- ========================= -->
    <!-- TOOLBAR SESUAI MODUL -->
    <!-- ========================= -->


    <!-- ========================= -->
    <!-- CONTENT -->
    <!-- ========================= -->

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/sigap_blue"
        android:elevation="4dp"
        app:subtitleTextColor="@android:color/white"
        app:title="SIGAP"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="175dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="25dp"
                android:paddingEnd="24dp"
                android:paddingBottom="20dp"
                android:background="@drawable/bg_header_sigap">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Halo, Nailah 👋"
                    android:textColor="@color/sigap_white"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Apa yang ingin Anda ajukan hari ini?"
                    android:textColor="@color/sigap_white"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvHeaderInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Sistem Layanan Sarana dan Prasarana PCR"
                    android:textColor="@color/sigap_white"
                    android:textSize="12sp"
                    android:alpha="0.85" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- CONTENT -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="20dp"
                android:paddingBottom="30dp">

                <!-- TITLE -->

                <TextView
                    android:id="@+id/tvMenuTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ajukan Pengajuan"
                    android:textColor="@color/sigap_blue_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />


                <!-- ========================= -->
                <!-- BARANG & RUANG -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardBarang"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/sigap_white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E3EAF5"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:src="@android:drawable/ic_menu_add"
                                android:contentDescription="Barang"
                                app:tint="@color/sigap_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Barang"
                                android:textColor="@color/sigap_blue_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Peminjaman"
                                android:textColor="@color/sigap_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardRuang"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/sigap_white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E3EAF5"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:src="@android:drawable/ic_menu_myplaces"
                                android:contentDescription="Ruang"
                                app:tint="@color/sigap_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Ruang"
                                android:textColor="@color/sigap_blue_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Peminjaman"
                                android:textColor="@color/sigap_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ========================= -->
                <!-- LAB & ASET -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLab"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        app:cardBackgroundColor="@color/sigap_white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E3EAF5"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:src="@android:drawable/ic_menu_manage"
                                android:contentDescription="Laboratorium"
                                app:tint="@color/sigap_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Laboratorium"
                                android:textColor="@color/sigap_blue_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Peminjaman"
                                android:textColor="@color/sigap_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardAset"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        app:cardBackgroundColor="@color/sigap_white"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp"
                        app:strokeColor="#E3EAF5"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="45dp"
                                android:layout_height="45dp"
                                android:src="@android:drawable/ic_menu_save"
                                android:contentDescription="Aset"
                                app:tint="@color/sigap_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Aset / Inventaris"
                                android:textColor="@color/sigap_blue_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Data aset"
                                android:textColor="@color/sigap_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>


                <!-- ========================= -->
                <!-- LAINNYA -->
                <!-- ========================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLainnya"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="@color/sigap_white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E3EAF5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp">

                        <TextView
                            android:layout_width="55dp"
                            android:layout_height="55dp"
                            android:background="@drawable/bg_icon_circle"
                            android:gravity="center"
                            android:text="•••"
                            android:textColor="@color/sigap_blue"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Layanan Lainnya"
                                android:textColor="@color/sigap_blue_dark"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text="Lihat layanan sarana dan prasarana lainnya"
                                android:textColor="@color/sigap_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textColor="@color/sigap_blue"
                            android:textSize="30sp" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================= -->
                <!-- PENGAJUAN AKTIF -->
                <!-- ========================= -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvActiveTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Pengajuan Aktif"
                        android:textColor="@color/sigap_blue_dark"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSeeAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lihat Semua ›"
                        android:textColor="@color/sigap_blue"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- ========================= -->
                <!-- STATUS -->
                <!-- ========================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStatus"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="@color/sigap_white"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E3EAF5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:gravity="center"
                            android:text="●"
                            android:textColor="@color/sigap_yellow"
                            android:textSize="22sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ruang Lab Komputer 2"
                                android:textColor="@color/sigap_blue_dark"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="28 September 2026"
                                android:textColor="@color/sigap_gray"
                                android:textSize="11sp" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_waiting"
                            android:paddingStart="12dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="7dp"
                            android:text="Menunggu"
                            android:textColor="@color/sigap_yellow"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ========================= -->
                <!-- WEBSITE -->
                <!-- ========================= -->

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebsite"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:text="Kunjungi Website PCR"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/sigap_blue"
                    app:cornerRadius="15dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>