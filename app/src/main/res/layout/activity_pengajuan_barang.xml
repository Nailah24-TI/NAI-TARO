<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F8FD">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0758C9"
        app:title="Pengajuan Barang"
        app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_arrow_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Form Peminjaman Barang"
            android:textColor="#172B4D"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Langkah 1 dari 4 • Detail Barang"
            android:textColor="#60738F"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/progressStep"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="14dp"
            android:max="4"
            android:progress="1"
            android:progressTint="#0877E8"
            android:progressBackgroundTint="#DCE6F4" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- LANGKAH 1: DETAIL BARANG -->
            <LinearLayout
                android:id="@+id/stepOne"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_input_sigap">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Detail Barang"
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"
                    android:text="Isi informasi barang yang ingin dipinjam."
                    android:textColor="#60738F"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Barang *"
                    android:textColor="#263B59"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etNamaBarang"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_sigap"
                    android:hint="Contoh: Proyektor"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#172B4D"
                    android:textColorHint="#8B9BB2"
                    android:textSize="14sp"
                    android:inputType="textCapSentences" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jumlah Barang *"
                    android:textColor="#263B59"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etJumlah"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_sigap"
                    android:hint="Masukkan jumlah"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#172B4D"
                    android:textColorHint="#8B9BB2"
                    android:textSize="14sp"
                    android:inputType="number" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keterangan"
                    android:textColor="#263B59"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etKeterangan"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_sigap"
                    android:gravity="top|start"
                    android:hint="Tambahkan keterangan barang jika ada"
                    android:padding="14dp"
                    android:textColor="#172B4D"
                    android:textColorHint="#8B9BB2"
                    android:textSize="14sp"
                    android:inputType="textCapSentences|textMultiLine" />

            </LinearLayout>

            <!-- LANGKAH 2: JADWAL -->
            <LinearLayout
                android:id="@+id/stepTwo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_input_sigap"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jadwal Peminjaman"
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"
                    android:text="Tentukan tanggal dan waktu penggunaan barang."
                    android:textColor="#60738F"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tanggal Peminjaman *"
                    android:textColor="#263B59"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etTanggal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_sigap"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Pilih tanggal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#172B4D"
                    android:textColorHint="#8B9BB2"
                    android:textSize="14sp"
                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                    android:drawablePadding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waktu Mulai *"
                    android:textColor="#263B59"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etWaktuMulai"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_sigap"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Pilih waktu mulai"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#172B4D"
                    android:textColorHint="#8B9BB2"
                    android:textSize="14sp"
                    android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
                    android:drawablePadding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waktu Selesai *"
                    android:textColor="#263B59"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etWaktuSelesai"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_sigap"
                    android:clickable="true"
                    android:focusable="false"
                    android:hint="Pilih waktu selesai"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#172B4D"
                    android:textColorHint="#8B9BB2"
                    android:textSize="14sp"
                    android:drawableEnd="@android:drawable/ic_lock_idle_alarm"
                    android:drawablePadding="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keperluan Peminjaman *"
                    android:textColor="#263B59"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etKeperluan"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_sigap"
                    android:gravity="top|start"
                    android:hint="Jelaskan keperluan peminjaman"
                    android:padding="14dp"
                    android:textColor="#172B4D"
                    android:textColorHint="#8B9BB2"
                    android:textSize="14sp"
                    android:inputType="textCapSentences|textMultiLine" />

            </LinearLayout>

            <!-- LANGKAH 3: UPLOAD BORANG -->
            <LinearLayout
                android:id="@+id/stepThree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_input_sigap"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Upload Borang Peminjaman"
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="18dp"
                    android:text="Lampirkan borang resmi peminjaman barang dari kampus. Pastikan dokumen yang dipilih sudah benar dan dapat dibuka."
                    android:textColor="#60738F"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="22dp"
                    android:background="#F0F6FF">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@android:drawable/ic_menu_upload"
                        android:contentDescription="Ikon upload borang"
                        android:tint="#0758C9" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="Pilih berkas borang"
                        android:textColor="#172B4D"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Format yang didukung: PDF, JPG, PNG"
                        android:textColor="#60738F"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPilihBorang"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Pilih Borang dari HP"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:backgroundTint="#0758C9"
                        app:cornerRadius="12dp" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="Berkas terpilih"
                    android:textColor="#263B59"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvNamaBorang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:padding="14dp"
                    android:background="@drawable/bg_input_sigap"
                    android:text="Belum ada berkas dipilih"
                    android:textColor="#60738F"
                    android:textSize="14sp"
                    android:breakStrategy="simple" />

                <TextView
                    android:id="@+id/tvStatusBorang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Borang wajib dilampirkan"
                    android:textColor="#B45309"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- LANGKAH 4: REVIEW -->
            <LinearLayout
                android:id="@+id/stepFour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:background="@drawable/bg_input_sigap"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Review Pengajuan"
                    android:textColor="#172B4D"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="18dp"
                    android:text="Periksa kembali informasi sebelum mengirim pengajuan."
                    android:textColor="#60738F"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nama Barang"
                    android:textColor="#60738F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReviewBarang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="-"
                    android:textColor="#172B4D"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Jumlah"
                    android:textColor="#60738F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReviewJumlah"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="-"
                    android:textColor="#172B4D"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keterangan"
                    android:textColor="#60738F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReviewKeterangan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="-"
                    android:textColor="#172B4D"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tanggal"
                    android:textColor="#60738F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReviewTanggal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="-"
                    android:textColor="#172B4D"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Waktu"
                    android:textColor="#60738F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReviewWaktu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="-"
                    android:textColor="#172B4D"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Keperluan"
                    android:textColor="#60738F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReviewKeperluan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:text="-"
                    android:textColor="#172B4D"
                    android:textSize="14sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="14dp"
                    android:background="#DCE5F2" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Borang Peminjaman"
                    android:textColor="#60738F"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvReviewBorang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:padding="14dp"
                    android:background="#F0F6FF"
                    android:text="Belum ada borang"
                    android:textColor="#0758C9"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:breakStrategy="simple" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Batal"
            android:textAllCaps="false"
            android:textColor="#0758C9"
            app:backgroundTint="#EAF2FF"
            app:cornerRadius="12dp"
            app:strokeColor="#C9DDF8"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Lanjut"
            android:textAllCaps="false"
            app:backgroundTint="#0758C9"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>